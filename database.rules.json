{
  "rules": {
    ".read": false,
    ".write": false,
    "r": {
      "$roomId": {
        ".read": true,
        ".write": "data.exists() || newData.child('id').exists()",
        ".validate": "$roomId.length > 0 && $roomId.length <= 16 && $roomId.matches(/^[A-Z0-9]+$/)",
        "m": {
          ".read": "root.child('r').child($roomId).exists()",
          "$memberId": {
            ".write": "root.child('r').child($roomId).exists()",
            ".validate": "$memberId.length == 8"
          }
        }
      }
    },
    "p": {
      "$roomId": {
        ".read": "root.child('r').child($roomId).exists()",
        ".write": "!newData.exists() || (root.child('r').child($roomId).exists() && newData.hasChild('exp'))",
        "$memberId": {
          ".write": "root.child('r').child($roomId).child('m').child($memberId).exists() || !newData.exists()",
          ".validate": "$memberId.length == 8"
        }
      }
    },
    "t": {
      "$roomId": {
        ".read": "root.child('r').child($roomId).exists()",
        ".write": "!newData.exists() || (root.child('r').child($roomId).exists() && newData.hasChild('exp'))",
        "o": {
          "$indicatorId": {
            ".write": "!newData.exists() || root.child('r').child($roomId).exists()"
          }
        },
        "i": {
          "$indicatorId": {
            ".write": "!newData.exists() || root.child('r').child($roomId).exists()"
          }
        }
      }
    }
  }
}
